<Page x:Class="FurniManager.Screens.Statistical.StatisticalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FurniManager.Screens.Statistical"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StatisticalPage">
    <ScrollViewer>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Biểu đồ số lượng sản phẩm theo loại -->
            <GroupBox Header="Số lượng sản phẩm theo loại" Grid.Row="0" Margin="5">
                <lvc:CartesianChart Series="{Binding ProductCountByCategoryChart}">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding ProductCountLabels}" />
                    </lvc:CartesianChart.AxisX>
                </lvc:CartesianChart>
            </GroupBox>

            <!-- Biểu đồ tồn kho sản phẩm -->
            <GroupBox Header="Tồn kho sản phẩm theo ngày" Grid.Row="1" Margin="5">
                <lvc:CartesianChart Series="{Binding ProductByDateChart}">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding ProductByDateLabels}" />
                    </lvc:CartesianChart.AxisX>
                </lvc:CartesianChart>
            </GroupBox>


            <GroupBox Header="Tồn kho sản phẩm theo số lượng" Grid.Row="2" Margin="5">
                <lvc:CartesianChart Series="{Binding StockLevelChart}">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding StockLevelLabels}" />
                    </lvc:CartesianChart.AxisX>
                </lvc:CartesianChart>
            </GroupBox>

        </Grid>
    </ScrollViewer>
   
</Page>
