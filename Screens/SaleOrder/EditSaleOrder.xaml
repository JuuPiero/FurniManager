<Page x:Class="FurniManager.Screens.SaleOrder.EditSaleOrder"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FurniManager.Screens.SaleOrder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditSaleOrder">

    <ScrollViewer Padding="20 ">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="4*"/>
                <!--4-->
                <RowDefinition Height="4* "/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" >
                <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="30" VerticalAlignment="Center"  Text="Chi tiết đơn hàng" Margin="0,0,0,12"/>
                <Button Content="Export invoice" Margin="30,0,0,0" Command="{Binding ExportInvoiceCommand}"/>
            </StackPanel>

            <StackPanel Grid.Row="1"  Orientation="Vertical" Margin="0,0,0,12">
                <TextBlock FontSize="20" Grid.Row="0" Text="Tên khách hàng"  />
                <TextBox  Text="{Binding SaleOrder.CustomerName}" FontSize="18" BorderThickness="1" Height="40"/>
            </StackPanel>

            <StackPanel Grid.Row="2"  Orientation="Vertical" Margin="0,0,0,12">
                <TextBlock FontSize="20" Grid.Row="0" Text="Số điện thoại"  />
                <TextBox  Text="{Binding SaleOrder.CustomerPhone}" FontSize="18" BorderThickness="1" Height="40"/>
            </StackPanel>

            <StackPanel Grid.Row="3"  Orientation="Vertical"  Margin="0,0,0,20">
                <TextBlock FontSize="20" Grid.Row="0" Text="Địa chỉ" />
                <TextBox Text="{Binding SaleOrder.CustomerAddress}" 
            FontSize="18"
            BorderThickness="1" Height="100" 
            TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Grid.Row="4"  Orientation="Vertical"  Margin="0,0,0,20">
                <TextBlock FontSize="20" Grid.Row="0" Text="Ghi chú" />
                <TextBox Text="{Binding SaleOrder.Note}" 
              FontSize="18"
              BorderThickness="1" Height="120" 
              TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>


            <DataGrid Grid.Row="5" 
          ItemsSource="{Binding SaleOrder.SaleOrderDetails}"
          AutoGenerateColumns="False" 
          IsReadOnly="False"
          CanUserAddRows="False"
          CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Sản phẩm" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Path=DataContext.Products, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Page}}"  
                             IsSynchronizedWithCurrentItem="False" IsHitTestVisible="False"  SelectedValue="{Binding ProductId}"  SelectedValuePath="Id"  DisplayMemberPath="Name"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox Foreground="#000" ItemsSource="{Binding Path=DataContext.Products, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Page}}"  
                                SelectedValue="{Binding ProductId}" SelectedValuePath="Id"  DisplayMemberPath="Name"  
                                IsSynchronizedWithCurrentItem="False">
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="*" />

                    <!--<DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalPrice}" IsReadOnly="True" Width="*"/>-->
                </DataGrid.Columns>
            </DataGrid>
            <!--<Button Grid.Row="6" Margin="0,10,0,10" Content="Thêm sản phẩm " Command="{Binding AddOrderItemCommand}" HorizontalAlignment="Left" Width="200"/>-->

            <StackPanel Grid.Row="7"  Orientation="Vertical" Margin="0,0,0,12">
                <TextBlock FontSize="20" Grid.Row="0" Text="Tổng tiền:"  />
                <TextBox IsReadOnly="true"  PreviewTextInput="NumberOnly_PreviewTextInput" Text="{Binding SaleOrder.TotalAmount}" FontSize="18" BorderThickness="1" Height="40"/>
            </StackPanel>
            <StackPanel Grid.Row="8"  Orientation="Vertical" Margin="0,0,0,12">
                <TextBlock FontSize="20" Grid.Row="0" Text="Trạng thái"  />
                <ComboBox Grid.Column="0" 
                 BorderThickness="1"
                 Height="40"
                 ItemsSource="{Binding Status}"
                 SelectedValue="{Binding SaleOrder.Status}"/>
            </StackPanel>

            <Button Grid.Row="9" Content="Save" Width="200" Command="{Binding SaveSaleOrderCommand}"/>
        </Grid>
    </ScrollViewer>
</Page>
