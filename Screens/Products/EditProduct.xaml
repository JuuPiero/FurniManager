<Page x:Class="FurniManager.Screens.Products.EditProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FurniManager.Screens.Products"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="EditProduct">

    <ScrollViewer Padding="20">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="30"  Text="Cập nhật sản phẩm" />

            <StackPanel Grid.Row="1"  Orientation="Vertical">
                <TextBlock FontSize="20" Grid.Row="0" Text="Tên sản phẩm" Margin="0,0,0,12" />
                <TextBox Text="{Binding Product.Name}"  FontSize="18" BorderThickness="1" Height="40"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Vertical">
                <TextBlock FontSize="20" Grid.Row="0" Text="Danh mục" Margin="0,0,0,12" />
                <ComboBox Grid.Column="0" 
                    BorderThickness="1"
                    Height="40"
                    ItemsSource="{Binding Categories}"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Id"
                    SelectedValue="{Binding Product.CategoryId}">
                </ComboBox>
            </StackPanel>
            <Grid Grid.Row="3" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical" MinWidth="320" HorizontalAlignment="Left">
                    <TextBlock Text="Giá bán(VNĐ)"  FontSize="20" Grid.Row="0" Margin="0,0,0,12" />
                    <TextBox 
                     PreviewTextInput="NumberOnly_PreviewTextInput"
                     Text="{Binding Product.Price}"  
                     FontSize="18" BorderThickness="1" Height="40"/>
                </StackPanel>
                <StackPanel Grid.Column="1"  Orientation="Vertical"  HorizontalAlignment="Stretch">
                    <TextBlock Text="Tồn kho"  FontSize="20" Grid.Row="0" Margin="0,0,0,12" />
                    <TextBox Text="{Binding Product.Quantity}"  PreviewTextInput="NumberOnly_PreviewTextInput"
                           FontSize="18" BorderThickness="1" Height="40"/>
                </StackPanel>
            </Grid>


            <StackPanel Grid.Row="4"  Orientation="Vertical">
                <TextBlock FontSize="20" Grid.Row="0" Text="Description" Margin="0,0,0,20" />
                <TextBox Text="{Binding Product.Description}" 
                      FontSize="18"
                      BorderThickness="1" Height="120" 
                      TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Margin="0,10,0,0" Grid.Row="5">
                <Button Content="Pick Images" Command="{Binding PickImagesCommand}" Width="300" HorizontalAlignment="Left" />

                <ItemsControl ItemsSource="{Binding DisplayImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Width="200" Height="200">
                                <Image.Source>
                                    <BitmapImage UriSource="{Binding TempPath}" />
                                </Image.Source>
                            </Image>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="6"  Orientation="Vertical" Margin="20, 10, 0, 10">
                <TextBlock Text="Thông tin chi tiết" FontSize="20"  HorizontalAlignment="Left" Width="200" Margin="0, 0, 0, 10"/>

                <ItemsControl ItemsSource="{Binding Product.Attributes}"  Margin="0, 0, 0, 10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0, 0, 0, 10">
                                <TextBox materialDesign:HintAssist.Hint="Key" FontSize="16" Height="30" BorderThickness="1" Width="120" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox materialDesign:HintAssist.Hint="Value" FontSize="16" Height="30" Width="120" BorderThickness="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add New Attribute" Command="{Binding AddAttributeCommand}" HorizontalAlignment="Left" Width="200"/>
            </StackPanel>

            <Button Grid.Row="7" Content="Submit" Width="200" Command="{Binding SaveProductCommand}"/>
        </Grid>
    </ScrollViewer>
</Page>
