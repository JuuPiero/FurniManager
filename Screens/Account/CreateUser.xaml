<Page x:Class="FurniManager.Screens.Account.CreateUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FurniManager.Screens.Account"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="CreateUser">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Form Chính -->
        <Border Grid.Row="1" Width="600" Padding="20" BorderBrush="#673bb7" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Create New User" FontSize="20"  FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Họ và tên -->
                <TextBlock Text="Name" Margin="0,5"/>
                <TextBox  Height="35" 
                          Background="#ccc"
                     BorderThickness="1" Padding="5" Text="{Binding User.Name}" />

                <!-- Email -->
                <TextBlock Text="Email" Margin="0,10,0,5"/>
                <TextBox x:Name="EmailBox" Height="35"
                           Background="#ccc"
                     BorderThickness="1" Padding="5" Text="{Binding User.Email}" />

                <!-- Mật khẩu -->
                <TextBlock Text="Mật khẩu" Margin="0,10,0,5"/>
                <PasswordBox  Height="35" 
                                Background="#ccc"
                         BorderThickness="1" Padding="5" PasswordChanged="PasswordBox_PasswordChanged" />

                <TextBlock Text="Role" Margin="0,10,0,5" />
                <ComboBox BorderThickness="1" Padding="5"
                            Background="#ccc"
                  SelectedValue="{Binding User.Role, Mode=TwoWay}"
                  ItemsSource="{Binding Roles}"
                  />
                <!-- Nút tạo user -->
                <Button 
                    Content="Submit" 
                    Height="40"
                    FontSize="16" Cursor="Hand" Margin="0,15,0,0"
                    BorderThickness="0" 
                    Command="{Binding SaveUserCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
