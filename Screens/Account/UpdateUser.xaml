<Page x:Class="FurniManager.Screens.Account.UpdateUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FurniManager.Screens.Account"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UpdateUser">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Form Chính -->
        <Border Grid.Row="1" Width="600" Padding="20"  Background="#393E46"
        HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock  Text="Update User" FontSize="20" Foreground="White" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Họ và tên -->
                <TextBlock Text="Name" Foreground="White" Margin="0,5"/>
                <TextBox Height="35" Background="#222831" Foreground="White"
                 BorderThickness="0" Padding="5" Text="{Binding User.Name}"/>

                <!-- Email -->
                <TextBlock Text="Email" Foreground="White" Margin="0,10,0,5"/>
                <TextBox Text="{Binding User.Email}" Height="35" Background="#222831" Foreground="White"
                 BorderThickness="0" Padding="5" />

                <!-- Mật khẩu -->
                <TextBlock Text="Mật khẩu" Foreground="White" Margin="0,10,0,5"/>
                <PasswordBox  Height="35" Background="#222831" Foreground="White"
                     BorderThickness="0" Padding="5" />

                <TextBlock Text="Role" Foreground="White" Margin="0,10,0,5"/>
                <ComboBox BorderThickness="1" Padding="5"
                    SelectedValue="{Binding User.Role, Mode=TwoWay}"
                    ItemsSource="{Binding Roles}"
                />

                <!-- Nút tạo user -->
                <Button Content="Submit" 
                Foreground="White" Height="40"
                FontSize="16" Cursor="Hand" Margin="0,15,0,0"
                BorderThickness="0" Command="{Binding SaveUserCommand}"  />
            </StackPanel>
        </Border>
    </Grid>
</Page>
