<Page x:Class="FurniManager.Screens.Account.ListUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FurniManager.Screens.Account"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:utils="clr-namespace:FurniManager.Utils"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListUser"
      >

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>
            <Button 
                Visibility="{Binding CurrentUser.IsAdmin, Source={x:Static utils:GlobalContext.Instance}}" 
                Content="Add New" 
                Width="150" 
                HorizontalAlignment="Right" Click="OpenCreateUser" />

            
            <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" AutoGenerateColumns="False"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserResizeColumns="True"
              CanUserResizeRows="False"
              CanUserSortColumns="True"
              SelectedItem="{Binding SelectedUser}"
              >

                <!-- Cột Tên -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn IsReadOnly="True" Header="Email" Binding="{Binding Email}" Width="2*"/>
                    <DataGridTextColumn IsReadOnly="True" Header="Role" Binding="{Binding Role}" Width="*"/>

                    <!-- Cột Nút Action -->
                    <DataGridTemplateColumn Header="Action" Width="Auto"  
                        Visibility="{Binding CurrentUser.IsAdmin, Source={x:Static utils:GlobalContext.Instance}, 
                        Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                                    <Button Content="Edit" Margin="0, 0, 10, 0"
                                        Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}" />
                                    <Button Content="Delete" Background="Red"
                                        Command="{Binding DataContext.DeleteUserCommand, 
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" 
                                           />
                                   
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Previous" Command="{Binding PrevPageCommand}" 
                    IsEnabled="{Binding CurrentPage, Mode=OneWay}" />
                <TextBlock Text="{Binding CurrentPage}" FontSize="16" FontWeight="Bold" Margin="10"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" 
                    IsEnabled="{Binding TotalPages, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</Page>
